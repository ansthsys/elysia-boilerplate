# Copy to .env (and .env.test for `bun test`) and adjust.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_NAME="Elysia Boilerplate"
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Must match the driver chosen in src/db/dialect.ts
#   postgres: postgresql://postgres:postgres@localhost:5432/app
#   mysql:    mysql://root:mysql@localhost:3306/app
#   sqlite:   file:./data/app.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Comma separated browser origins allowed to call the API (with cookies)
CORS_ORIGINS=http://localhost:5173

# Feature switches
AUTH_ENABLED=true
AUTH_ROLES_ENABLED=true
AUTH_BEARER_ENABLED=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# HTTP-level switches: hide the endpoint, keep the capability (seeders still work)
AUTH_SIGN_UP_ENABLED=true
AUTH_PASSWORD_RESET_ENABLED=true
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-string-of-32-chars-or-more

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Read the client IP from X-Forwarded-For - only behind a reverse proxy you control
# TRUST_PROXY=false

# API docs at /docs: on by default, OFF by default when NODE_ENV=production
# OPENAPI_ENABLED=true

# Storage: local filesystem (default) or s3 (AWS S3 / R2 / MinIO)
#   local: bytes in STORAGE_LOCAL_PATH, downloads through /api/files/raw with an HMAC URL
#   s3:    bytes in the bucket, downloads through provider-presigned URLs
# Serverless must use s3 (the filesystem is ephemeral).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Defaults to APP_URL when empty
# STORAGE_PUBLIC_BASE_URL=http://localhost:3000
# Defaults to BETTER_AUTH_SECRET when empty
# STORAGE_SIGNING_SECRET=
STORAGE_MAX_FILE_SIZE=5m

# Required only when STORAGE_DRIVER=s3
# S3_BUCKET=uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_VIRTUAL_HOSTED_STYLE=false

# Optional: without it emails are only logged
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="My App <noreply@example.com>"

# Vercel cron calls the internal mail drain with: Authorization: Bearer <CRON_SECRET>
# Leave empty locally; the endpoint returns 404 when unset.
# CRON_SECRET=
