# Copy to .env (and .env.test for `bun test`) and adjust.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_NAME="Elysia Boilerplate"
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Must match the driver chosen in src/db/dialect.ts
#   postgres: postgresql://postgres:postgres@localhost:5432/app
#   mysql:    mysql://root:mysql@localhost:3306/app
#   sqlite:   file:./data/app.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Comma separated browser origins allowed to call the API (with cookies)
CORS_ORIGINS=http://localhost:5173

# Feature switches
AUTH_ENABLED=true
AUTH_ROLES_ENABLED=true
AUTH_BEARER_ENABLED=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-string-of-32-chars-or-more

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Read the client IP from X-Forwarded-For - only behind a reverse proxy you control
# TRUST_PROXY=false

# API docs at /docs: on by default, OFF by default when NODE_ENV=production
# OPENAPI_ENABLED=true

# Optional: without it emails are only logged
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="My App <noreply@example.com>"
