# Copy to .env.test - loaded automatically by `bun test`. Use a separate database: tests write data.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_test
BETTER_AUTH_SECRET=test-secret-that-is-at-least-32-characters-long
RATE_LIMIT_ENABLED=false
AUTH_ENABLED=true
AUTH_ROLES_ENABLED=true
AUTH_SIGN_UP_ENABLED=true
AUTH_PASSWORD_RESET_ENABLED=true

# Storage: tests use the local driver and clean up after themselves
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/test-storage
CRON_SECRET=test-cron-secret-at-least-16-chars
