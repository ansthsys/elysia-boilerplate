# Production environment template. Copy to .env.production (never commit the real file).
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_NAME="Elysia Boilerplate"
APP_URL=https://api.example.com
LOG_LEVEL=info

# Must match the driver chosen in src/db/dialect.ts
DATABASE_URL=postgresql://user:password@host:5432/app

CORS_ORIGINS=https://app.example.com

# Required, 32+ characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Behind a reverse proxy / load balancer that sets X-Forwarded-For
TRUST_PROXY=true

# Rate limiting across instances should happen at the edge (see docs/deployment.md)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Docs are off by default in production
OPENAPI_ENABLED=false

# Storage: local needs a persistent volume; serverless must use s3
STORAGE_DRIVER=s3
STORAGE_PUBLIC_BASE_URL=https://api.example.com
STORAGE_MAX_FILE_SIZE=10m

S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_VIRTUAL_HOSTED_STYLE=false

RESEND_API_KEY=
EMAIL_FROM="My App <noreply@example.com>"

# Required in production for the mail-drain scheduler
CRON_SECRET=
