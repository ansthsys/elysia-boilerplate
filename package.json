{
	"name": "elysia-boilerplate",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"description": "Production-ready Elysia v1 REST API boilerplate for Bun: Better Auth, Drizzle (PostgreSQL/MySQL/SQLite), driver-based storage, end-to-end type safety. Docker, conventional servers and Vercel (Bun runtime).",
	"license": "MIT",
	"imports": {
		"#app": "./src/app.ts",
		"#shared": "./src/shared/index.ts",
		"#*": "./src/*.ts"
	},
	"exports": {
		"./client": "./src/client.ts",
		"./shared": "./src/shared/index.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "NODE_ENV=production bun run src/index.ts",
		"build": "bun build --target=bun --minify --sourcemap=external --outdir=dist src/index.ts src/db/migrate.ts src/db/seed.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "bun test",
		"db:generate": "bun --bun drizzle-kit generate",
		"db:migrate": "bun run src/db/migrate.ts",
		"db:seed": "bun run src/db/seed.ts",
		"db:studio": "bun --bun drizzle-kit studio",
		"openapi:export": "bun run scripts/export-openapi.ts"
	},
	"dependencies": {
		"@elysiajs/cors": "1.4.3",
		"@elysiajs/openapi": "1.4.17",
		"@sinclair/typebox": "0.34.52",
		"better-auth": "1.7.25",
		"drizzle-orm": "0.45.4",
		"drizzle-typebox": "0.3.3",
		"elysia": "1.4.32",
		"elysia-rate-limit": "4.6.3",
		"mysql2": "3.24.6",
		"pino": "10.4.0",
		"postgres": "^3.4.9",
		"resend": "6.38.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@elysiajs/eden": "1.4.9",
		"@faker-js/faker": "10.6.0",
		"@types/bun": "^1.4.4",
		"drizzle-kit": "0.31.11",
		"pino-pretty": "^13.2.0",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"@sinclair/typebox": "0.34.52"
	}
}
